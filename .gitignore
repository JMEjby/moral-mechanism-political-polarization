!sim-pack-full-model/outputs/raw_txt/.gitkeep
sim-pack-full-model/outputs/raw_csv/*
!sim-pack-full-model/outputs/raw_csv/.gitkeep
sim-pack-full-model/outputs/combined_data/*
!sim-pack-full-model/outputs/combined_data/.gitkeep

